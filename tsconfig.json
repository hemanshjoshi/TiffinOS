{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "constants/*": ["constants/*"],
      "services/*": ["services/*"],
      "store/*": ["store/*"],
      "hooks/*": ["hooks/*"],
      "components/*": ["components/*"],
      "utils/*": ["src/utils/*"],
      "types/*": ["src/types/*"]
    }
  }
}
